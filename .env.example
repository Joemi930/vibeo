# Vibeo — variables d'environnement (modèle)
#
# NE PAS mettre de vraies valeurs ici. Ce fichier est le SEUL fichier d'env
# suivi par git ; il documente les clés attendues.
#
# Pour lancer l'app, crée un fichier `env.json` (ignoré par git) à la racine
# avec ce format, puis lance :
#   flutter run -d chrome --dart-define-from-file=env.json
#   flutter run            --dart-define-from-file=env.json   (Android)
#
# env.json :
# {
#   "SUPABASE_URL": "https://<ton-projet>.supabase.co",
#   "SUPABASE_ANON_KEY": "<clé publique anon / publishable>"
# }
#
# IMPORTANT : n'utilise JAMAIS la clé service_role dans l'app Flutter — elle
# reste uniquement dans les secrets des Edge Functions.

SUPABASE_URL=
SUPABASE_ANON_KEY=
